# BSREA monitoring dashboard settings. Copy to .env (deploy/install.sh does) and fill in ALERT_WEBHOOK_URL.
# Everything else has a default that fits the server set up as in docs/deployment.md.

# Alerts to your phone: install the free "ntfy" app, subscribe to a topic with a long random name,
# and put its address here. A Discord or Slack webhook address works too. Test with: npm run test-alert
ALERT_WEBHOOK_URL=

# The public addresses (used for the uptime checks and the HTTPS certificate check).
# When the site moves to its own domain, change these to https://bsreabd.org and https://admin.bsreabd.org
SITE_URL=https://bsrea-demo.duckdns.org
ADMIN_URL=https://admin.bsrea-demo.duckdns.org
# The API is checked directly on this machine
# API_HEALTH_URL=http://127.0.0.1:3002/health

# Alert when the disk or memory is fuller than this (percent)
# ALERT_DISK_PERCENT=85
# ALERT_MEMORY_PERCENT=90
# A problem that is still there is reported again after this many hours
# ALERT_REMIND_HOURS=6

# Attack protection: block addresses that clearly attack (1 = on, 0 = only watch and record)
# AUTO_BLOCK=1
# Addresses that are never blocked, comma-separated (for example the office's public IP)
# ALLOW_IPS=

# Where to find things (defaults shown)
# NGINX_LOG=/var/log/nginx/bsrea.access.log
# BACKEND_DB=../backend/storage/bsrea.db
# BACKEND_STORAGE=../backend/storage
# BACKUP_DIR=/var/backups/bsrea

# The dashboard listens here; nginx passes monitor.<your domain> to it
# PORT=3005
# Sign-ins last this many hours
# SESSION_HOURS=12
# Days are counted in this time zone
# TIMEZONE=Asia/Dhaka
