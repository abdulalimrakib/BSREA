{
  "name": "bsrea-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon",
    "start": "ts-node server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "ts-node scripts/seed.ts",
    "keygen": "node -e \"const c=require('crypto');console.log('ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'));console.log('BLIND_INDEX_KEY='+c.randomBytes(32).toString('hex'))\"",
    "backup": "ts-node scripts/backup.ts",
    "restore": "ts-node scripts/restore.ts",
    "retention": "ts-node scripts/retention.ts",
    "reset-password": "ts-node scripts/reset-password.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "demo-data": "ts-node scripts/demo-data.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "description": "BSREA REST API"
}
