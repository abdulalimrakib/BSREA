PORT=3002
# Comma-separated list of websites allowed to call the API
CORS_ORIGINS=http://localhost:3004,http://localhost:3001
# Folder for saved files such as contact form messages (default: ./storage)
STORAGE_DIR=storage

# Secrets for sensitive data: run "npm run keygen" and paste the two lines here.
# Keep them safe and backed up: without ENCRYPTION_KEY, stored ID numbers and documents can't be read.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Database file (default: storage/bsrea.db)
# DATABASE_FILE=storage/bsrea.db
# Public website address, used in certificate QR codes
PUBLIC_SITE_URL=http://localhost:3004
# Set to 1 when running behind a reverse proxy
# TRUST_PROXY=1

# Two-factor login for staff: on by default in production. 1 = required, 0 = optional
# REQUIRE_TWO_FACTOR=1
# Backups ("npm run backup"): where to write them and how many to keep
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# Documents of rejected applications are deleted this many days after the decision ("npm run retention")
# RETENTION_DAYS=180
# ClamAV virus scanner (clamd). When set, every upload is scanned
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# On the server, behind nginx: listen on this machine only, and trust nginx's X-Forwarded-For
# HOST=127.0.0.1
# TRUST_PROXY=1
