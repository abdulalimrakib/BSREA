<mxfile host="app.diagrams.net">
  <diagram id="bsrea-membership-workflow" name="Membership workflow">
    <mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BSREA Membership Workflow: from application to certificate verification" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1200" height="40" as="geometry"/></mxCell><mxCell id="L0" value="&lt;b&gt;Applicant&lt;/b&gt;&lt;br&gt;&lt;small&gt;public website&lt;/small&gt;" style="swimlane;horizontal=0;startSize=110;fillColor=#F3FAF5;strokeColor=#D5DAE1;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1740" height="150" as="geometry"/></mxCell><mxCell id="L1" value="&lt;b&gt;BSREA system&lt;/b&gt;&lt;br&gt;&lt;small&gt;automatic&lt;/small&gt;" style="swimlane;horizontal=0;startSize=110;fillColor=#F6F9FF;strokeColor=#D5DAE1;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1740" height="150" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;Staff&lt;/b&gt;&lt;br&gt;&lt;small&gt;admin panel&lt;/small&gt;" style="swimlane;horizontal=0;startSize=110;fillColor=#FFFAF0;strokeColor=#D5DAE1;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1740" height="150" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b&gt;Approver&lt;/b&gt;&lt;br&gt;&lt;small&gt;approver or admin&lt;/small&gt;" style="swimlane;horizontal=0;startSize=110;fillColor=#FFF7F2;strokeColor=#D5DAE1;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1740" height="150" as="geometry"/></mxCell><mxCell id="L4" value="&lt;b&gt;Anyone&lt;/b&gt;&lt;br&gt;&lt;small&gt;verify page&lt;/small&gt;" style="swimlane;horizontal=0;startSize=110;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="1740" height="150" as="geometry"/></mxCell><mxCell id="start" value="Company wants&lt;br&gt;to join BSREA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="L0"><mxGeometry x="120" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="form" value="Fill online form&lt;br&gt;&lt;small&gt;+ upload documents&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="L0"><mxGeometry x="300" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="refused" value="Refused&lt;br&gt;&lt;small&gt;already a member or applied&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="L0"><mxGeometry x="660" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="ref" value="Gets reference no.&lt;br&gt;&lt;small&gt;APP-2026-XXXXXXXX&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="L0"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="valid" value="Form and&lt;br&gt;files OK?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="L1"><mxGeometry x="290" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="dup" value="Exact&lt;br&gt;duplicate?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="L1"><mxGeometry x="470" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="save" value="Encrypt and save&lt;br&gt;&lt;small&gt;flag possible matches&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;" vertex="1" parent="L1"><mxGeometry x="660" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="review" value="Start review&lt;br&gt;&lt;small&gt;status: Under review&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="L2"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="flagged" value="Possible&lt;br&gt;matches?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="L2"><mxGeometry x="1010" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="check" value="Check matches&lt;br&gt;&lt;small&gt;write a note&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;" vertex="1" parent="L2"><mxGeometry x="1200" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="rejected" value="Rejected&lt;br&gt;&lt;small&gt;files deleted after 180 days&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="L3"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="decide" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="L3"><mxGeometry x="1010" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="member" value="Create member&lt;br&gt;&lt;small&gt;from the application&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="L3"><mxGeometry x="1200" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="cert" value="Issue certificate&lt;br&gt;&lt;small&gt;PDF with QR code&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="L3"><mxGeometry x="1380" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="invalid" value="Warning shown&lt;br&gt;&lt;small&gt;expired, revoked or fake&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="L4"><mxGeometry x="1020" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="scan" value="Scan QR or&lt;br&gt;enter the code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="L4"><mxGeometry x="1200" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="status" value="Certificate&lt;br&gt;valid?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="L4"><mxGeometry x="1370" y="30" width="160" height="90" as="geometry"/></mxCell><mxCell id="ok" value="Valid&lt;br&gt;&lt;small&gt;company, type, dates&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="L4"><mxGeometry x="1570" y="45" width="140" height="60" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="L0" source="start" target="form"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="form" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="No: fix errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="valid" target="form"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="L1" source="valid" target="dup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="dup" target="refused"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="L1" source="dup" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="save" target="ref"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="new application" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="save" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="L2" source="review" target="flagged"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="L2" source="flagged" target="check"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="flagged" target="decide"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="different person" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="check" target="decide"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="L3" source="decide" target="rejected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="L3" source="decide" target="member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="L3" source="member" target="cert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="QR code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;dashed=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="cert" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="L4" source="scan" target="status"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="L4" source="status" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="L4" source="status" target="invalid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Exact duplicate (blocked):&lt;/b&gt; same company name, trade licence, BIN or TIN as a member or an open application. The applicant is never told which member matched.&lt;br&gt;&lt;b&gt;Possible match (flagged):&lt;/b&gt; shared email, phone or NID, a 88%+ similar name, or the same uploaded file." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=10;spacingRight=10;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="0" y="780" width="560" height="110" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Four-eyes rule:&lt;/b&gt; the staff member who checks the flagged matches can't approve that application; a second person (approver or admin) must decide.&lt;br&gt;&lt;b&gt;Unflagged applications:&lt;/b&gt; an approver can decide directly after review." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=10;spacingRight=10;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="590" y="780" width="560" height="110" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Data protection at every step:&lt;/b&gt; personal details, ID numbers and documents are encrypted; ID numbers are masked unless revealed; every login, view, reveal, download and decision is written to the audit log; certificates can be revoked at any time." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=10;spacingRight=10;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="560" height="110" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt;  green = start / success   ·   blue = step   ·   yellow = decision   ·   orange = manual check   ·   purple = stored encrypted   ·   red = refused / rejected   ·   dashed line = printed on the certificate" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="0" y="905" width="1740" height="30" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
